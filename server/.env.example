NODE_ENV=development
PORT=5000

# Vercel only: set NODEJS_HELPERS=0 in the Vercel project settings so Vercel
# doesn't pre-parse request bodies (the webhook signature check needs the raw body).
# NODEJS_HELPERS=0

# Neon: Dashboard -> your project -> Connect -> direct connection string (host WITHOUT "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# At least 32 characters: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# HMAC secret shared with the chat system (the assessment's test secret)
WEBHOOK_SECRET=verdant-demo-secret-2026

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=20000

# Retrieval (RAG): embedding model and number of policies sent per message.
# Run `npm run db:embed` after changing the knowledge base.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=3

BRAND_ID=verdant-co

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# Used only by `npm run db:seed`
DEMO_AGENT_EMAIL=agent@verdant.co
DEMO_AGENT_PASSWORD=Verdant@2026
